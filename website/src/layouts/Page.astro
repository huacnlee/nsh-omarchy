---
// The frame every page shares: head, header with navigation, footer.
import '../styles/global.css';
import ThemeMenu from '../components/ThemeMenu';
import Seo from '../components/Seo.astro';
interface Props {
  title: string;
  description: string;
  path?: string;
  current?: 'home' | 'api';
  bodyClass?: string;
}
const { title, description, path = '', current = 'home', bodyClass } = Astro.props;
const asset = (file: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${file}`;
const repo = 'https://github.com/huacnlee/nsh-omarchy';
---
<!doctype html>
<html lang="en" data-theme="tokyo-night">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="icon" type="image/png" sizes="192x192" href={asset('icon.png')} />
    <style is:inline set:html={`@font-face{font-family:"Omarchy Display";src:url("${asset('fonts/omarchy.ttf')}") format("truetype");font-weight:400;font-style:normal;font-display:swap;}`} />
    <Seo title={title} description={description} path={path} api={current === 'api'} />
    <script is:inline>
      try { const theme = localStorage.getItem('nsh-omarchy-theme'); if (['tokyo-night', 'flexoki-light'].includes(theme)) document.documentElement.dataset.theme = theme; } catch {}
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header"><div class="shell">
      <a class="site-name" href={asset('')} aria-label="NSH Omarchy home"><span class="site-logo" style={`--site-logo-url:url("${asset('favicon.svg')}")`} aria-hidden="true"></span></a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href={`${asset('')}#components`} class="desktop-link">Components</a>
        <a href={`${asset('')}#start`} class="desktop-link">Get started</a>
        <a href={asset('api/')} aria-current={current === 'api' ? 'page' : undefined}>API</a>
        <a href={repo}>GitHub</a>
        <ThemeMenu client:load />
      </nav>
    </div></header>
    <slot />
    <footer class="site-footer"><div class="shell">
      <span>NSH Omarchy · An independent community project.</span>
      <span>By <a class="text-link" href="https://github.com/huacnlee">Jason Lee</a> · <a class="text-link" href={`${repo}/blob/main/LICENSE`}>MIT license</a></span>
    </div></footer>
  </body>
</html>
