---
// The API reference: docs/api.md, the crate's frozen API contract, as it is.
import '../styles/guides.css';
import Page from '../layouts/Page.astro';
import { Content, getHeadings } from '../../../docs/api.md';
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path}`;
const chapters = getHeadings().filter((heading) => heading.depth === 2);
---
<Page title="NSH Omarchy API — every component in Rust and TSX" description="The complete nsh-omarchy API: every component's constructor, props, shorthands and events, in Rust and TSX, frozen from 0.1.0." path="api/" current="api" bodyClass="guides-page">
  <div class="shell guides-grid">
    <aside class="guide-contents">
      <details open>
        <summary>On this page</summary>
        <nav aria-label="API chapters">
          {chapters.map((chapter) => <a href={`#${chapter.slug}`}>{chapter.text}</a>)}
        </nav>
      </details>
    </aside>
    <main id="main" class="guide-prose">
      <a class="guide-download" href={asset('api.md')} download="nsh-omarchy-api.md">Download Markdown</a>
      <Content />
    </main>
  </div>
</Page>
